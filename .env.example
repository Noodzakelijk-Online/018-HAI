# Copy this file to .env.local for local development:
#   copy .env.example .env.local
#
# Start with:
#   docker compose --env-file .env.local -f docker-compose.local.yml up --build

COMPOSE_PROJECT_NAME=018-hai

# Shared database defaults for local containers.
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# IDP database.
IDP_DB_NAME=idp
IDP_DB_HOST=postgres-idp

# Automation database.
AUTOMATION_DB_NAME=automation_hub
AUTOMATION_DB_HOST=postgres-automation

# Service ports inside the Docker network.
WEB_SERVER_PORT=8080
SERVER_PORT=80
BASE_URL=/api
# --- Secrets ------------------------------------------------------------------
# Every "change-this-*" value below is a placeholder, not a secret. Run
#   ./scripts/generate-secrets.sh >> .env.local
# to produce real ones.
#
# With RUN_MODE=production, /readyz reports `not_ready` (HTTP 503) while any of
# these still holds its placeholder, and the backend container is marked
# unhealthy. That is deliberate: a default credential should stop a production
# boot, not sail through it.
BACKEND_API_SHARED_KEY=change-this-local-backend-key
# Use a separate long random passphrase in production. If empty, the backend
# shared key is used so local encrypted chat capture remains operational.
HAI_MEMORY_ENCRYPTION_KEY=change-this-local-memory-encryption-key
# Per-client-IP request cap per minute. 0 (default) disables rate limiting.
RATE_LIMIT_PER_MINUTE=0

# Prometheus metrics are disabled unless explicitly enabled. The endpoint is
# bearer-token protected and should be scraped only by a local collector.
HAI_PROMETHEUS_ENABLED=false
HAI_PROMETHEUS_TOKEN=

# --- Gmail connector (Google OAuth) ------------------------------------------
# Leave empty to keep the Gmail connector honestly reporting "not_implemented".
# To enable it, create an OAuth 2.0 Web-application client in Google Cloud
# Console (enable the Gmail API, add your address as a test user), then set:
#   GOOGLE_OAUTH_CLIENT_ID     the client id
#   GOOGLE_OAUTH_CLIENT_SECRET the client secret
#   GOOGLE_OAUTH_REDIRECT_URL  <public-base>/api/v1/sources/oauth/google/callback
# The redirect URL must be reachable from Google, so during local development it
# is the public gateway URL (e.g. an ngrok URL), and must match the redirect URI
# registered on the OAuth client exactly. Read-only Gmail scope only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
# "Sign in with Google" for the app login (separate from the Gmail connector,
# handled by the IDP). Reuses the same client id/secret, but its redirect is a
# distinct path and must ALSO be registered on the Google OAuth client:
#   GOOGLE_LOGIN_REDIRECT_URL=<public-base>/api/v1/auth/google/callback
# Leave empty to hide/disable the Google login button's backend.
GOOGLE_LOGIN_REDIRECT_URL=

# --- Password-reset email (optional SMTP) -----------------------------------
# Password recovery is intentionally unavailable until a private mail sender is
# configured. Use a dedicated mailbox or app password, not a primary password.
# This sender must support STARTTLS (normally port 587). Never commit values in
# .env.local. For a Gmail account, create a Google App Password first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_STARTTLS=true
# Run mode: production | demo | test. Non-production is labelled and performs no
# real external side effects. Unknown/empty defaults to production.
RUN_MODE=production
BACKEND_PORT=17070
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_ADDR=redis:6379

# --- Host port mappings -------------------------------------------------------
# Only the gateway is published; it is loopback-bound by default and the intended
# entry point. Postgres, Redis and the backend bind to 127.0.0.1 so the stack
# never exposes a database to the LAN. Do not expose the gateway while the local
# login shortcut is enabled.
#
# Override any of these when a port is already taken on the host. The default
# Redis host port is 6380, not 6379, precisely because a developer machine
# commonly already runs Redis on 6379 — publishing there makes the whole stack
# fail to start with "port is already allocated".
GATEWAY_HOST_PORT=8088
# Keep the gateway loopback-only by default. Set 0.0.0.0 only after removing
# LOCAL_LOGIN_BYPASS_ENABLED and reviewing the exposure.
GATEWAY_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6380
IDP_DB_HOST_PORT=5433
AUTOMATION_DB_HOST_PORT=5434

# Kafka local setup uses one broker.
ZOOKEEPER_PORT=2181
KAFKA_BROKER=kafka:9092
KAFKA_BROKERS=kafka:9092
BROKERS_ADDR=kafka:9092
KAFKA_TOPIC=automation-events
LOGGER_TOPIC=logger
MAIL_TOPIC=mail
KAFKA_CLIENT_ID=idp

# Authentication and first-run local admin account.
FIRST_RUN_ADMIN_EMAIL=noodzakelijkonline@gmail.com
FIRST_RUN_ADMIN_PASSWORD=ChangeMe123!
IDP_COOKIE_SECURE=false
# Optional local dashboard button. Only enable on a loopback-bound single-user
# machine; it issues the configured first-run owner's normal signed session.
LOCAL_LOGIN_BYPASS_ENABLED=false
JWT_SECRET=change-this-local-secret
BLOCKING_TIME_EXPONENTIATION_BASIS=2
MAX_LOGIN_ATTEMPTS_BEFORE_BLOCK=5
MIN_TIME_BETWEEN_ATTEMPTS_IN_SECONDS=60
EXPIRATION_TIME_RESET_TOKEN_IN_HOURS=24
ACCESS_TOKEN_DURATION_MINUTES=15
REFRESH_TOKEN_DURATION_DAYS=5
PASSWORD_RESET_TOPIC=password-reset
ACCOUNT_BLOCKED_TOPIC=account-blocked
ACCOUNT_CREATED_TOPIC=account-created

# Backend uploads.
IMAGE_MAX_SIZE_IN_MB=5
IMAGE_EXTENSIONS=.jpg,.jpeg,.png
IMAGE_SAVE_DIR=/root/images

# Controlled automation runtime execution.
AUTOMATION_API_ALLOWED_HOSTS=localhost,127.0.0.1,::1,backend,frontend,gateway,generic-auto,idp
AUTOMATION_API_ALLOW_LINK_LOCAL=false
AUTOMATION_HEALTH_ALLOWED_HOSTS=localhost,127.0.0.1,::1,backend,frontend,gateway,generic-auto,idp
AUTOMATION_HEALTH_ALLOW_LINK_LOCAL=false
AUTOMATION_SCRIPT_EXECUTION_ENABLED=false
AUTOMATION_SCRIPT_DIR=/root/automation-scripts
AUTOMATION_SCRIPT_TIMEOUT_SECONDS=30
AUTOMATION_SCRIPT_ENV_ALLOWLIST=
AUTOMATION_DOCKER_CONTROL_ENABLED=false
AUTOMATION_DOCKER_SOCKET=/var/run/docker.sock
AUTOMATION_DOCKER_ALLOWED_CONTAINERS=

# Connected-source local folder ingestion. Files are read from ./connected-sources
# through this container path and must remain inside the allowlisted root.
CONNECTED_SOURCE_LOCAL_ROOT=/root/connected-sources
CONNECTED_SOURCE_FILE_LIMIT=100
CONNECTED_SOURCE_MAX_BYTES=1048576
# Normalized JSON feeds let local account bridges and reviewed API adapters
# submit source records without storing their credentials in HAI.
CONNECTED_SOURCE_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,api.github.com
CONNECTED_SOURCE_HTTP_ALLOW_LINK_LOCAL=false
CONNECTED_SOURCE_HTTP_TIMEOUT_SECONDS=20
CONNECTED_SOURCE_HTTP_MAX_BYTES=2097152
GITHUB_SOURCE_API_BASE_URL=https://api.github.com
GITHUB_SOURCE_TOKEN=
SOURCE_SCHEDULER_ENABLED=true
SOURCE_SCHEDULER_INTERVAL_SECONDS=600
SOURCE_SCHEDULER_RUN_ON_STARTUP=false
WORKFLOW_SCHEDULER_ENABLED=true
WORKFLOW_OPEN_LOOP_SCHEDULER_ENABLED=true
WORKFLOW_SCHEDULER_INTERVAL_SECONDS=600
WORKFLOW_SCHEDULER_RUN_LIMIT=2
WORKFLOW_SCHEDULER_RUN_ON_STARTUP=false
WORKFLOW_CLAIM_LEASE_SECONDS=900

# Ambient proactive planning. The scheduler creates source-linked proposals by
# default. It cannot execute ready workflows unless the server operator enables
# AMBIENT_EXECUTION_ENABLED; existing approval and emergency-stop gates still apply.
AMBIENT_SCHEDULER_ENABLED=true
AMBIENT_EXECUTION_ENABLED=false
AMBIENT_RUN_ON_STARTUP=false
AMBIENT_SCAN_INTERVAL_SECONDS=3600
AMBIENT_MINIMUM_SCORE=35
AMBIENT_MINIMUM_CONFIDENCE=35
AMBIENT_OPPORTUNITY_LIMIT=50
AMBIENT_EXECUTION_LIMIT=3
AMBIENT_DISMISS_COOLDOWN_HOURS=168
AMBIENT_SCAN_RETENTION=100
AUTONOMY_WORLD_STATE_TTL_SECONDS=300
AUTONOMY_TELEMETRY_LIMIT=25

# LLM routing policy. Providers can be replaced with JSON configuration.
LLM_POLICY_JSON=
LLM_PROVIDERS_JSON=
LLM_REQUIRE_RECENT_LIVE_PROBE=false
LLM_PROVIDER_PROBE_MAX_AGE_SECONDS=900
OLLAMA_BASE_URL=
LM_STUDIO_BASE_URL=
# llama.cpp must remain local: use http://host.docker.internal:<port> when HAI
# runs in Docker and llama-server runs on Windows, or a loopback address when
# both run on the same host. The provider remains inactive until /v1/models
# returns a successful probe.
LLAMA_CPP_BASE_URL=
LLAMA_CPP_MODEL_ID=local-model
ODYSSEUS_BASE_URL=
ODYSSEUS_API_TOKEN=
NOUS_PORTAL_BASE_URL=
NOUS_PORTAL_API_KEY=
MIXTURE_OF_AGENTS_BASE_URL=
MIXTURE_OF_AGENTS_API_KEY=
OPENAI_CODEX_BASE_URL=
OPENAI_CODEX_API_KEY=
# Controlled external agent runtimes are disabled by default. Enabling a
# runtime still does not bypass HAI approval, emergency-stop, verification,
# host allowlist, timeout, or audit controls.
AGENT_RUNTIME_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,odysseus,openclaw
AGENT_RUNTIME_OUTPUT_LIMIT_BYTES=65536
AGENT_RUNTIME_WORKSPACE_ROOT=/root/agent-workspaces
ODYSSEUS_AGENT_ENABLED=false
# Create/select this session in Odysseus first. HAI will not create a session
# using an arbitrary model endpoint on the operator's behalf.
ODYSSEUS_AGENT_SESSION_ID=
ODYSSEUS_AGENT_WORKSPACE=
ODYSSEUS_AGENT_TIMEOUT_SECONDS=120
# Odysseus ecosystem visibility and execution flags. Keep high-risk execution
# surfaces disabled until the matching HAI approval and audit flow is verified.
ODYSSEUS_CODEX_BRIDGE_ENABLED=true
ODYSSEUS_CLAUDE_BRIDGE_ENABLED=false
ODYSSEUS_TODOS_ENABLED=false
ODYSSEUS_NOTES_ENABLED=false
ODYSSEUS_TASKS_ENABLED=false
ODYSSEUS_EMAIL_ENABLED=false
ODYSSEUS_CALENDAR_ENABLED=false
ODYSSEUS_CONTACTS_ENABLED=false
ODYSSEUS_DOCUMENTS_ENABLED=false
ODYSSEUS_MEMORY_SYNC_ENABLED=false
ODYSSEUS_RESEARCH_ENABLED=false
ODYSSEUS_SEARCH_ENABLED=false
ODYSSEUS_MCP_ENABLED=false
ODYSSEUS_COOKBOOK_ENABLED=false
ODYSSEUS_LOCAL_MODEL_DISCOVERY_ENABLED=false
ODYSSEUS_SHELL_ENABLED=false
ODYSSEUS_BROWSER_ENABLED=false
ODYSSEUS_VAULT_ENABLED=false
ODYSSEUS_GALLERY_ENABLED=false
ODYSSEUS_TTS_ENABLED=false
ODYSSEUS_STT_ENABLED=false
ODYSSEUS_COMPANION_ENABLED=false
ODYSSEUS_WEBHOOKS_ENABLED=false
ODYSSEUS_AGENT_MIGRATION_ENABLED=false
ODYSSEUS_CONTEXT_BUDGET_ENABLED=false
ODYSSEUS_AGENT_ALLOW_BASH=false
ODYSSEUS_AGENT_ALLOW_WEB_SEARCH=false
ODYSSEUS_AGENT_ALLOW_RESEARCH=false
HERMES_AGENT_ENABLED=false
HERMES_EXECUTABLE=hermes
# Optional Hermes data/profile scope. Use this when HAI should run Hermes
# against a dedicated profile instead of the operator's default Hermes home.
HERMES_HOME=
HERMES_PROFILE=
HERMES_IGNORE_USER_CONFIG=false
# This must be a dedicated folder that Hermes may inspect or modify. Do not
# point it at an entire user profile or unrestricted filesystem root.
HERMES_WORKSPACE=/root/agent-workspaces/hermes
HERMES_MAX_TURNS=20
HERMES_TIMEOUT_SECONDS=120
# Optional comma-separated Hermes toolsets and skills. Leave empty to let the
# configured Hermes profile decide. Prefer restrictive toolsets such as safe,
# web, file, skills, todo, or explicitly reviewed custom bundles.
HERMES_TOOLSETS=
HERMES_SKILLS=
# Ecosystem visibility flags. These do not bypass HAI approvals; they tell the
# runtime registry which Hermes surfaces are intentionally part of this HAI node.
HERMES_GATEWAY_ENABLED=false
HERMES_CRON_ENABLED=false
HERMES_MCP_ENABLED=false
HERMES_MOA_ENABLED=false
HERMES_SUBAGENTS_ENABLED=false
HERMES_MEMORY_SYNC_ENABLED=false
HERMES_ACP_ENABLED=false
HERMES_TERMINAL_BACKENDS=local,docker,ssh,singularity,modal,daytona
# Add only the credential/config variable names Hermes needs. Values are
# inherited at runtime but are never returned through the registry API.
HERMES_ENV_ALLOWLIST=
OPENCLAW_AGENT_ENABLED=false
OPENCLAW_EXECUTABLE=openclaw
# Optional local Gateway URL. For a Windows-host OpenClaw Gateway use:
# ws://host.docker.internal:18789
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_STATE_DIR=
OPENCLAW_CONFIG_PATH=
# Optional read-only ecosystem inventory source. This may point at an extracted
# OpenClaw repository/package or at openclaw-main.zip. HAI lists skills, skill
# scripts, root scripts, extensions, providers, channels, apps, packages, source
# modules, docs, QA/test assets, config profiles, security assets, deployment
# descriptors, prompt maps, GitHub workflows, repository docs/config, and
# control UI/controller modules from it, but does not run scripts, import code,
# or dispatch upstream automations from this path.
OPENCLAW_ECOSYSTEM_PATH=
# This must be a dedicated folder that OpenClaw may inspect or modify. Do not
# point it at an entire user profile or unrestricted filesystem root.
OPENCLAW_WORKSPACE=/root/agent-workspaces/openclaw
OPENCLAW_TIMEOUT_SECONDS=120
OPENCLAW_THINKING=high
OPENCLAW_ENV_ALLOWLIST=
# HAI only invokes `openclaw agent --message ...` through this adapter.
# Messaging, pairing, nodes, browser, cron, and public posting require separate
# reviewed HAI workflows before they should be enabled.
OPENCLAW_AGENT_CLI_ENABLED=true
OPENCLAW_GATEWAY_ENABLED=false
OPENCLAW_MESSAGES_ENABLED=false
OPENCLAW_SKILLS_ENABLED=false
OPENCLAW_PLUGINS_ENABLED=false
OPENCLAW_MCP_ENABLED=false
OPENCLAW_MEMORY_ENABLED=false
OPENCLAW_CRON_ENABLED=false
OPENCLAW_BROWSER_ENABLED=false
OPENCLAW_CANVAS_ENABLED=false
OPENCLAW_NODES_ENABLED=false
OPENCLAW_VOICE_ENABLED=false
OPENCLAW_TALK_ENABLED=false
OPENCLAW_WEBCHAT_ENABLED=false
OPENCLAW_PAIRING_ENABLED=false
OPENCLAW_EXEC_APPROVALS_ENABLED=false
OPENCLAW_HOST_TOOLS_ENABLED=false
OPENCLAW_PUBLIC_POSTING_ENABLED=false
OPENCLAW_WEB_SEARCH_ENABLED=false
OPENCLAW_MULTI_AGENT_ENABLED=false
OPENCLAW_APP_SDK_ENABLED=false
OPENCLAW_PLUGIN_SDK_ENABLED=false
OPENCLAW_LOCAL_MODELS_ENABLED=false
OPENCLAW_ALLOW_HIGH_RISK_EXECUTION=false
OPENCLAW_SANDBOX_REQUIRED=true
OPENCLAW_SANDBOX_MODE=all
OPENCLAW_SANDBOX_DOCKER_ENABLED=false
OPENCLAW_SANDBOX_SSH_ENABLED=false
OPENCLAW_SANDBOX_OPENSHELL_ENABLED=false
OPENCLAW_CHANNELS_ENABLED=
OPENCLAW_PROVIDERS_ENABLED=
OPENCLAW_COMPANION_APPS=windows,macos,ios,android
FREE_CLOUD_OPENAI_BASE_URL=
FREE_CLOUD_API_KEY=
LLM_GENERATION_TIMEOUT_SECONDS=60
LLM_ALLOW_LINK_LOCAL_ENDPOINTS=false
# DualPath is only meaningful for disaggregated LLM serving with separate
# prefill/decode engines, shared KV-cache storage, a compute transfer network,
# and a compatible global scheduler. Keep disabled for ordinary Ollama/LM Studio.
LLM_KV_CACHE_LOAD_STRATEGY=disabled
LLM_DUALPATH_INFRASTRUCTURE_VERIFIED=false

# Nginx config manager.
NGINX_CONTAINER=gateway
CONFIG_DIR=/app/sites-enabled
NGINX_RELOAD_ENABLED=false

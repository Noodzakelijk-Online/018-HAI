# Copy this file to .env.local for local development:
#   copy .env.example .env.local
#
# Start with:
#   docker compose --env-file .env.local -f docker-compose.local.yml up --build

COMPOSE_PROJECT_NAME=018-hai

# Shared database defaults for local containers.
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# IDP database.
IDP_DB_NAME=idp
IDP_DB_HOST=postgres-idp

# Automation database.
AUTOMATION_DB_NAME=automation_hub
AUTOMATION_DB_HOST=postgres-automation

# Service ports inside the Docker network.
WEB_SERVER_PORT=8080
SERVER_PORT=80
BASE_URL=/api
BACKEND_API_SHARED_KEY=change-this-local-backend-key
# Use a separate long random passphrase in production. If empty, the backend
# shared key is used so local encrypted chat capture remains operational.
HAI_MEMORY_ENCRYPTION_KEY=change-this-local-memory-encryption-key
BACKEND_PORT=17070
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_ADDR=redis:6379

# Kafka local setup uses one broker.
ZOOKEEPER_PORT=2181
KAFKA_BROKER=kafka:9092
KAFKA_BROKERS=kafka:9092
BROKERS_ADDR=kafka:9092
KAFKA_TOPIC=automation-events
LOGGER_TOPIC=logger
MAIL_TOPIC=mail
KAFKA_CLIENT_ID=idp

# Authentication and first-run local admin account.
FIRST_RUN_ADMIN_EMAIL=noodzakelijkonline@gmail.com
FIRST_RUN_ADMIN_PASSWORD=ChangeMe123!
JWT_SECRET=change-this-local-secret
BLOCKING_TIME_EXPONENTIATION_BASIS=2
MAX_LOGIN_ATTEMPTS_BEFORE_BLOCK=5
MIN_TIME_BETWEEN_ATTEMPTS_IN_SECONDS=60
EXPIRATION_TIME_RESET_TOKEN_IN_HOURS=24
ACCESS_TOKEN_DURATION_MINUTES=15
REFRESH_TOKEN_DURATION_DAYS=5
PASSWORD_RESET_TOPIC=password-reset
ACCOUNT_BLOCKED_TOPIC=account-blocked
ACCOUNT_CREATED_TOPIC=account-created

# Backend uploads.
IMAGE_MAX_SIZE_IN_MB=5
IMAGE_EXTENSIONS=.jpg,.jpeg,.png
IMAGE_SAVE_DIR=/root/images

# Controlled automation runtime execution.
AUTOMATION_API_ALLOWED_HOSTS=localhost,127.0.0.1,::1,backend,frontend,gateway,generic-auto,idp
AUTOMATION_API_ALLOW_LINK_LOCAL=false
AUTOMATION_HEALTH_ALLOWED_HOSTS=localhost,127.0.0.1,::1,backend,frontend,gateway,generic-auto,idp
AUTOMATION_HEALTH_ALLOW_LINK_LOCAL=false
AUTOMATION_SCRIPT_EXECUTION_ENABLED=false
AUTOMATION_SCRIPT_DIR=/root/automation-scripts
AUTOMATION_SCRIPT_TIMEOUT_SECONDS=30
AUTOMATION_SCRIPT_ENV_ALLOWLIST=
AUTOMATION_DOCKER_CONTROL_ENABLED=false
AUTOMATION_DOCKER_SOCKET=/var/run/docker.sock
AUTOMATION_DOCKER_ALLOWED_CONTAINERS=

# Connected-source local folder ingestion. Files are read from ./connected-sources
# through this container path and must remain inside the allowlisted root.
CONNECTED_SOURCE_LOCAL_ROOT=/root/connected-sources
CONNECTED_SOURCE_FILE_LIMIT=100
CONNECTED_SOURCE_MAX_BYTES=1048576
SOURCE_SCHEDULER_ENABLED=true
SOURCE_SCHEDULER_INTERVAL_SECONDS=60
WORKFLOW_SCHEDULER_ENABLED=true
WORKFLOW_OPEN_LOOP_SCHEDULER_ENABLED=true
WORKFLOW_SCHEDULER_INTERVAL_SECONDS=60
WORKFLOW_SCHEDULER_RUN_LIMIT=5
WORKFLOW_CLAIM_LEASE_SECONDS=900

# Ambient proactive planning. The scheduler creates source-linked proposals by
# default. It cannot execute ready workflows unless the server operator enables
# AMBIENT_EXECUTION_ENABLED; existing approval and emergency-stop gates still apply.
AMBIENT_SCHEDULER_ENABLED=true
AMBIENT_EXECUTION_ENABLED=false
AMBIENT_SCAN_INTERVAL_SECONDS=300
AMBIENT_MINIMUM_SCORE=35
AMBIENT_MINIMUM_CONFIDENCE=35
AMBIENT_OPPORTUNITY_LIMIT=50
AMBIENT_EXECUTION_LIMIT=3
AMBIENT_DISMISS_COOLDOWN_HOURS=168
AMBIENT_SCAN_RETENTION=500
AUTONOMY_WORLD_STATE_TTL_SECONDS=300
AUTONOMY_TELEMETRY_LIMIT=25

# LLM routing policy. Providers can be replaced with JSON configuration.
LLM_POLICY_JSON=
LLM_PROVIDERS_JSON=
OLLAMA_BASE_URL=
LM_STUDIO_BASE_URL=
ODYSSEUS_BASE_URL=
ODYSSEUS_API_TOKEN=
# Controlled external agent runtimes are disabled by default. Enabling a
# runtime still does not bypass HAI approval, emergency-stop, verification,
# host allowlist, timeout, or audit controls.
AGENT_RUNTIME_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,odysseus
AGENT_RUNTIME_OUTPUT_LIMIT_BYTES=65536
AGENT_RUNTIME_WORKSPACE_ROOT=/root/agent-workspaces
ODYSSEUS_AGENT_ENABLED=false
# Create/select this session in Odysseus first. HAI will not create a session
# using an arbitrary model endpoint on the operator's behalf.
ODYSSEUS_AGENT_SESSION_ID=
ODYSSEUS_AGENT_WORKSPACE=
ODYSSEUS_AGENT_TIMEOUT_SECONDS=120
HERMES_AGENT_ENABLED=false
HERMES_EXECUTABLE=hermes
# This must be a dedicated folder that Hermes may inspect or modify. Do not
# point it at an entire user profile or unrestricted filesystem root.
HERMES_WORKSPACE=/root/agent-workspaces/hermes
HERMES_MAX_TURNS=20
HERMES_TIMEOUT_SECONDS=120
HERMES_TOOLSETS=
# Add only the credential/config variable names Hermes needs. Values are
# inherited at runtime but are never returned through the registry API.
HERMES_ENV_ALLOWLIST=
FREE_CLOUD_OPENAI_BASE_URL=
FREE_CLOUD_API_KEY=
LLM_GENERATION_TIMEOUT_SECONDS=60
LLM_ALLOW_LINK_LOCAL_ENDPOINTS=false
# DualPath is only meaningful for disaggregated LLM serving with separate
# prefill/decode engines, shared KV-cache storage, a compute transfer network,
# and a compatible global scheduler. Keep disabled for ordinary Ollama/LM Studio.
LLM_KV_CACHE_LOAD_STRATEGY=disabled
LLM_DUALPATH_INFRASTRUCTURE_VERIFIED=false

# Nginx config manager.
NGINX_CONTAINER=gateway
CONFIG_DIR=/app/sites-enabled
NGINX_RELOAD_ENABLED=false

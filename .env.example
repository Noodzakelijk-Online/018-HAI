# Copy this file to .env.local for local development:
#   copy .env.example .env.local
#
# Start with:
#   docker compose --env-file .env.local up --build

COMPOSE_PROJECT_NAME=018-hai

# Shared database defaults for local containers.
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# IDP database.
IDP_DB_NAME=idp
IDP_DB_HOST=postgres-idp

# Automation database.
AUTOMATION_DB_NAME=automation_hub
AUTOMATION_DB_HOST=postgres-automation

# Service ports inside the Docker network.
WEB_SERVER_PORT=8080
SERVER_PORT=80
BASE_URL=/api
# --- Secrets ------------------------------------------------------------------
# Every "change-this-*" value below is a placeholder, not a secret. Run
#   ./scripts/generate-secrets.sh >> .env.local
# to produce real ones.
#
# With RUN_MODE=production, /readyz reports `not_ready` (HTTP 503) while any of
# these still holds its placeholder, and the backend container is marked
# unhealthy. That is deliberate: a default credential should stop a production
# boot, not sail through it.
BACKEND_API_SHARED_KEY=change-this-local-backend-key
# Use a separate long random passphrase in production. If empty, the backend
# shared key is used so local encrypted chat capture remains operational.
HAI_MEMORY_ENCRYPTION_KEY=change-this-local-memory-encryption-key
# Per-client-IP request cap per minute. 0 (default) disables rate limiting.
RATE_LIMIT_PER_MINUTE=0

# Prometheus metrics are disabled unless explicitly enabled. The endpoint is
# bearer-token protected and should be scraped only by a local collector.
HAI_PROMETHEUS_ENABLED=false
HAI_PROMETHEUS_TOKEN=

# --- Gmail connector (Google OAuth) ------------------------------------------
# Leave empty to keep the Gmail connector honestly reporting "not_implemented".
# To enable it, create an OAuth 2.0 Web-application client in Google Cloud
# Console (enable the Gmail API, add your address as a test user), then set:
#   GOOGLE_OAUTH_CLIENT_ID     the client id
#   GOOGLE_OAUTH_CLIENT_SECRET the client secret
#   GOOGLE_OAUTH_REDIRECT_URL  <public-base>/api/v1/sources/oauth/google/callback
# The redirect URL must be reachable from Google, so during local development it
# is the public gateway URL (e.g. an ngrok URL), and must match the redirect URI
# registered on the OAuth client exactly. Read-only Gmail scope only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
# "Sign in with Google" for the app login (separate from the Gmail connector,
# handled by the IDP). Reuses the same client id/secret, but its redirect is a
# distinct path and must ALSO be registered on the Google OAuth client:
#   GOOGLE_LOGIN_REDIRECT_URL=<public-base>/api/v1/auth/google/callback
# Leave empty to hide/disable the Google login button's backend.
GOOGLE_LOGIN_REDIRECT_URL=

# --- Trello connector (read-only, not yet live) ------------------------------
# Keep these application credentials in the ignored .env.local file. They are
# deliberately separate from TRELLO_READ_TOKEN: a Trello API key and OAuth
# secret identify HAI's OAuth application, but do not authorize access to an
# administrator's boards. A read-only user token must be obtained through an
# explicit authorization flow before a future live connector can read data.
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_READ_TOKEN=

# --- Password-reset email (optional SMTP) -----------------------------------
# Password recovery is intentionally unavailable until a private mail sender is
# configured. Use a dedicated mailbox or app password, not a primary password.
# This sender must support STARTTLS (normally port 587). Never commit values in
# .env.local. For a Gmail account, create a Google App Password first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_STARTTLS=true
# Run mode: production | demo | test. Non-production is labelled and performs no
# real external side effects. Unknown/empty defaults to production.
RUN_MODE=production
BACKEND_PORT=17070
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_ADDR=redis:6379

# --- Host port mappings -------------------------------------------------------
# Only the gateway is published; it is loopback-bound by default and the intended
# entry point. Postgres, Redis and the backend bind to 127.0.0.1 so the stack
# never exposes a database to the LAN. Do not expose the gateway while the local
# login shortcut is enabled.
#
# Override any of these when a port is already taken on the host. The default
# Redis host port is 6380, not 6379, precisely because a developer machine
# commonly already runs Redis on 6379 — publishing there makes the whole stack
# fail to start with "port is already allocated".
GATEWAY_HOST_PORT=80
# Keep the gateway loopback-only by default. Set 0.0.0.0 only after removing
# LOCAL_LOGIN_BYPASS_ENABLED and reviewing the exposure.
GATEWAY_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6380
IDP_DB_HOST_PORT=5433
AUTOMATION_DB_HOST_PORT=5434

# Kafka local setup uses one broker.
ZOOKEEPER_PORT=2181
KAFKA_BROKER=kafka:9092
KAFKA_BROKERS=kafka:9092
BROKERS_ADDR=kafka:9092
KAFKA_TOPIC=automation-events
LOGGER_TOPIC=logger
MAIL_TOPIC=mail
KAFKA_CLIENT_ID=idp

# Authentication and first-run local admin account.
FIRST_RUN_ADMIN_EMAIL=noodzakelijkonline@gmail.com
FIRST_RUN_ADMIN_PASSWORD=ChangeMe123!
IDP_COOKIE_SECURE=false
# Optional local dashboard button. Only enable on a loopback-bound single-user
# machine; it issues the configured first-run owner's normal signed session.
LOCAL_LOGIN_BYPASS_ENABLED=false
JWT_SECRET=change-this-local-secret
BLOCKING_TIME_EXPONENTIATION_BASIS=2
MAX_LOGIN_ATTEMPTS_BEFORE_BLOCK=5
MIN_TIME_BETWEEN_ATTEMPTS_IN_SECONDS=60
EXPIRATION_TIME_RESET_TOKEN_IN_HOURS=24
ACCESS_TOKEN_DURATION_MINUTES=15
REFRESH_TOKEN_DURATION_DAYS=5
PASSWORD_RESET_TOPIC=password-reset
ACCOUNT_BLOCKED_TOPIC=account-blocked
ACCOUNT_CREATED_TOPIC=account-created

# Backend uploads.
IMAGE_MAX_SIZE_IN_MB=5
IMAGE_EXTENSIONS=.jpg,.jpeg,.png
IMAGE_SAVE_DIR=/root/images

# Controlled automation runtime execution.
AUTOMATION_API_ALLOWED_HOSTS=localhost,127.0.0.1,::1,backend,frontend,gateway,generic-auto,idp
AUTOMATION_API_ALLOW_LINK_LOCAL=false
AUTOMATION_HEALTH_ALLOWED_HOSTS=localhost,127.0.0.1,::1,backend,frontend,gateway,generic-auto,idp
AUTOMATION_HEALTH_ALLOW_LINK_LOCAL=false
AUTOMATION_SCRIPT_EXECUTION_ENABLED=false
AUTOMATION_SCRIPT_DIR=/root/automation-scripts
AUTOMATION_SCRIPT_TIMEOUT_SECONDS=30
AUTOMATION_SCRIPT_ENV_ALLOWLIST=
# Comma-separated reviewed pins, for example: health.sh=<64 lowercase hex SHA-256>
AUTOMATION_SCRIPT_SHA256_ALLOWLIST=
AUTOMATION_DOCKER_CONTROL_ENABLED=false
AUTOMATION_DOCKER_SOCKET=/var/run/docker.sock
AUTOMATION_DOCKER_ALLOWED_CONTAINERS=

# Connected-source local folder ingestion. Files are read from ./connected-sources
# through this container path and must remain inside the allowlisted root.
CONNECTED_SOURCE_LOCAL_ROOT=/root/connected-sources
CONNECTED_SOURCE_FILE_LIMIT=100
CONNECTED_SOURCE_MAX_BYTES=1048576
# Normalized JSON feeds let local account bridges and reviewed API adapters
# submit source records without storing their credentials in HAI.
CONNECTED_SOURCE_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,api.github.com
CONNECTED_SOURCE_HTTP_ALLOW_LINK_LOCAL=false
CONNECTED_SOURCE_HTTP_TIMEOUT_SECONDS=20
CONNECTED_SOURCE_HTTP_MAX_BYTES=2097152
GITHUB_SOURCE_API_BASE_URL=https://api.github.com
# Optional read-only fine-grained token for private repositories. HAI reads
# repository metadata, issues, pull requests, branches, commits, and workflow
# runs only; it never writes to GitHub. Each sync reads newest records first,
# follows at most ten 100-record pages per resource, and retains the existing
# cursor if the bounded window is exceeded so it cannot silently skip work.
GITHUB_SOURCE_TOKEN=
SOURCE_SCHEDULER_ENABLED=true
SOURCE_SCHEDULER_INTERVAL_SECONDS=600
SOURCE_SCHEDULER_RUN_ON_STARTUP=false
WORKFLOW_SCHEDULER_ENABLED=true
WORKFLOW_OPEN_LOOP_SCHEDULER_ENABLED=true
WORKFLOW_SCHEDULER_INTERVAL_SECONDS=600
WORKFLOW_SCHEDULER_RUN_LIMIT=2
WORKFLOW_SCHEDULER_RUN_ON_STARTUP=false
WORKFLOW_CLAIM_LEASE_SECONDS=900

# Ambient proactive planning. The scheduler creates source-linked proposals by
# default. It cannot execute ready workflows unless the server operator enables
# AMBIENT_EXECUTION_ENABLED; existing approval and emergency-stop gates still apply.
AMBIENT_SCHEDULER_ENABLED=true
AMBIENT_EXECUTION_ENABLED=false
AMBIENT_RUN_ON_STARTUP=false
AMBIENT_SCAN_INTERVAL_SECONDS=3600
AMBIENT_MINIMUM_SCORE=35
AMBIENT_MINIMUM_CONFIDENCE=35
AMBIENT_OPPORTUNITY_LIMIT=50
AMBIENT_EXECUTION_LIMIT=3
AMBIENT_DISMISS_COOLDOWN_HOURS=168
AMBIENT_SCAN_RETENTION=100
AUTONOMY_WORLD_STATE_TTL_SECONDS=300
AUTONOMY_TELEMETRY_LIMIT=25

# LLM routing policy. Providers can be replaced with JSON configuration.
LLM_POLICY_JSON=
LLM_PROVIDERS_JSON=
LLM_REQUIRE_RECENT_LIVE_PROBE=false
LLM_PROVIDER_PROBE_MAX_AGE_SECONDS=900
# HAI checks every model that current routing policy can use before it is routed
# or generated. The same persisted gate is required by optional planning and
# fixed local evaluation runners before they issue a model request. Ollama is
# the only supported automatic update adapter: it calls its local /api/pull
# endpoint at most once per model every 24 hours. Other runtimes must report
# the exact configured model ID, but HAI will not guess an update operation;
# cloud model versions are provider-managed. Set false only for controlled
# development diagnosis.
LLM_MODEL_MAINTENANCE_ENABLED=true
# Fixed daily freshness interval. Any other value is clamped to 24 so a
# configuration typo cannot multiply checks or defer a model's daily check.
LLM_MODEL_MAINTENANCE_INTERVAL_HOURS=24
# Failed daily checks are retried after five minutes by default so a temporary
# local runtime/download outage cannot block a model for a full day. Values
# below one minute are raised to one; values above one hour are reduced.
LLM_MODEL_MAINTENANCE_FAILURE_RETRY_MINUTES=5
# Default: 900 seconds. Values below 30 seconds are raised to 30; values above
# one hour are reduced to one hour so a stalled local pull cannot block routing
# indefinitely.
LLM_MODEL_MAINTENANCE_TIMEOUT_SECONDS=900
# Fixed hourly lightweight sweep. Any other value is clamped to 60, while
# durable per-model records still prevent provider I/O before the daily due time.
LLM_MODEL_MAINTENANCE_SCHEDULER_ENABLED=true
LLM_MODEL_MAINTENANCE_SCHEDULER_INTERVAL_MINUTES=60
# Optional owner-controlled public catalog maintenance. This reads a small
# batch of fixed GitHub repository metadata and records redacted availability,
# licence, archive, and rename evidence. It never installs, activates, or
# reclassifies an upstream project. Disabled by default to avoid background
# external requests until explicitly enabled.
HAI_CATALOG_REVALIDATION_ENABLED=false
# Optional companion source-index check. When both catalog switches are true,
# HAI compares its fixed OSS Insight collection snapshot once per day and
# stores only counts, collection names, and drift summary. It does not fetch
# repository code, discover repositories, or activate a project.
HAI_CATALOG_COLLECTION_REVALIDATION_ENABLED=false
# Optional companion repository-gap review. When all catalog switches are
# true, HAI scans only the pre-screened reviewable OSS Insight categories once
# per day and stores aggregate counts plus at most 30 candidate names. It does
# not fetch source code, packages, credentials, or activate a project.
HAI_CATALOG_REPOSITORY_DISCOVERY_REVALIDATION_ENABLED=false
# At most 24 hours between checks; the background scheduler walks the catalog
# in small batches and skips entries with recent durable evidence.
HAI_CATALOG_REVALIDATION_INTERVAL_HOURS=24
HAI_CATALOG_REVALIDATION_BATCH_SIZE=8
HAI_CATALOG_REVALIDATION_SCHEDULER_ENABLED=true
HAI_CATALOG_REVALIDATION_SCHEDULER_INTERVAL_MINUTES=60
OLLAMA_BASE_URL=
# Comma-separated allowlist of exact Ollama tags HAI may route and maintain.
# Only these tags are checked every 24 hours; HAI never downloads the rest of
# its model catalog merely because an Ollama endpoint is configured.
OLLAMA_MODEL_IDS=phi3:mini
LM_STUDIO_BASE_URL=
# Exact ID reported by LM Studio's /v1/models endpoint. HAI checks this ID
# daily before use and never silently substitutes another loaded model.
LM_STUDIO_MODEL_ID=local-model
# llama.cpp must remain local: use http://host.docker.internal:<port> when HAI
# runs in Docker and llama-server runs on Windows, or a loopback address when
# both run on the same host. The provider remains inactive until /v1/models
# returns a successful probe.
LLAMA_CPP_BASE_URL=
LLAMA_CPP_MODEL_ID=local-model
# LocalAI is an optional operator-installed local server. HAI accepts only a
# loopback or host.docker.internal endpoint, does not download models, and
# keeps the profile inactive until /v1/models passes a live probe.
LOCALAI_BASE_URL=
LOCALAI_MODEL_ID=localai-default
# vLLM is an optional operator-installed local model server. HAI accepts only
# a loopback or host.docker.internal endpoint and keeps the profile inactive
# until /v1/models passes a live probe. Configure a model explicitly; HAI does
# not download or start it.
VLLM_BASE_URL=
VLLM_MODEL_ID=vllm-default
# SGLang is an optional operator-installed local OpenAI-compatible server.
# HAI accepts only a loopback or host.docker.internal endpoint and checks the
# exact configured model through /v1/models before routing. It never pulls an
# SGLang image or model automatically; review an upstream update separately.
SGLANG_BASE_URL=
SGLANG_MODEL_ID=sglang-default
# mistral.rs is an optional operator-installed local OpenAI-compatible server.
# HAI calls only /v1/models and /v1/chat/completions, never its UI, agent,
# shell, web, file, MCP, Skills, or code-execution surfaces. Use a loopback or
# host.docker.internal endpoint and start mistralrs without agentic tools.
MISTRAL_RS_BASE_URL=
MISTRAL_RS_MODEL_ID=mistralrs-default
# DSpark is available only as an explicitly enabled loopback local server. HAI
# rejects a public or LAN endpoint for routing, probes the exact model ID daily,
# and never starts the server or substitutes its configured model.
DSPARK_ENABLED=false
DSPARK_BASE_URL=
DSPARK_MODEL_ID=dspark-default
DSPARK_PROBE_PATH=/v1/models
DSPARK_GENERATION_PATH=/v1/chat/completions
# LiteLLM is an optional, operator-installed local proxy. HAI only accepts a
# loopback or host.docker.internal endpoint and requires a LiteLLM virtual key.
# HAI cannot verify the proxy's upstream model billing, so every generation
# through this gateway remains manually approval-gated.
LITELLM_ENABLED=false
LITELLM_BASE_URL=
LITELLM_MODEL_ID=local-model
LITELLM_API_KEY=
# Local semantic retrieval is opt-in. HAI sends only source-extraction text and
# editable context-memory text to this loopback/host.docker.internal
# OpenAI-compatible embedding endpoint, stores vectors in the local
# pgvector-enabled automation database, and falls back to keyword retrieval if
# the endpoint is unavailable. Do not use a cloud URL.
HAI_SEMANTIC_RETRIEVAL_ENABLED=false
HAI_EMBEDDING_BASE_URL=
HAI_EMBEDDING_MODEL=
HAI_EMBEDDING_API_KEY=
HAI_EMBEDDING_INPUT_LIMIT=12000
HAI_EMBEDDING_TIMEOUT_SECONDS=10
# Opt-in local OR-Tools proposal solver. It accepts only opaque task IDs, time
# windows, durations, and priorities, then returns an audited proposal. It
# never writes to workflows, calendars, files, tools, or external services.
HAI_PLANNING_OPTIMIZER_ENABLED=false
HAI_PLANNING_OPTIMIZER_BASE_URL=http://ortools-solver:8080
HAI_PLANNING_OPTIMIZER_TIMEOUT_SECONDS=5
HAI_PLANNING_OPTIMIZER_MAX_SOLVE_SECONDS=2
ODYSSEUS_BASE_URL=
ODYSSEUS_API_TOKEN=
# Runtime Lab uses a separate health-only adapter for external agent runtimes.
# Only hosts named here can be probed. Add a remote hostname deliberately only
# after reviewing the endpoint; the default permits local Docker/loopback names.
RUNTIME_LAB_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,hermes,openclaw,odysseus,openhands
HERMES_BASE_URL=
HERMES_HEALTH_PATH=/health
OPENCLAW_BASE_URL=
OPENCLAW_HEALTH_PATH=/health
ODYSSEUS_HEALTH_PATH=/health
# Optional OpenHands Agent Canvas/Agent Server health endpoint. HAI only uses
# the configured GET health route; it cannot start agents, read workspaces, or
# call tools through this Runtime Lab adapter.
OPENHANDS_BASE_URL=
OPENHANDS_HEALTH_PATH=/health
NOUS_PORTAL_BASE_URL=
NOUS_PORTAL_API_KEY=
MIXTURE_OF_AGENTS_BASE_URL=
MIXTURE_OF_AGENTS_API_KEY=
OPENAI_CODEX_BASE_URL=
OPENAI_CODEX_API_KEY=
# Controlled external agent runtimes are disabled by default. Enabling a
# runtime still does not bypass HAI approval, emergency-stop, verification,
# host allowlist, timeout, or audit controls.
AGENT_RUNTIME_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,odysseus,openclaw
AGENT_RUNTIME_OUTPUT_LIMIT_BYTES=65536
AGENT_RUNTIME_WORKSPACE_ROOT=/root/agent-workspaces
ODYSSEUS_AGENT_ENABLED=false
# Create/select this session in Odysseus first. HAI will not create a session
# using an arbitrary model endpoint on the operator's behalf.
ODYSSEUS_AGENT_SESSION_ID=
ODYSSEUS_AGENT_WORKSPACE=
ODYSSEUS_AGENT_TIMEOUT_SECONDS=120
# Odysseus ecosystem visibility and execution flags. Keep high-risk execution
# surfaces disabled until the matching HAI approval and audit flow is verified.
ODYSSEUS_CODEX_BRIDGE_ENABLED=true
ODYSSEUS_CLAUDE_BRIDGE_ENABLED=false
ODYSSEUS_TODOS_ENABLED=false
ODYSSEUS_NOTES_ENABLED=false
ODYSSEUS_TASKS_ENABLED=false
ODYSSEUS_EMAIL_ENABLED=false
ODYSSEUS_CALENDAR_ENABLED=false
ODYSSEUS_CONTACTS_ENABLED=false
ODYSSEUS_DOCUMENTS_ENABLED=false
ODYSSEUS_MEMORY_SYNC_ENABLED=false
ODYSSEUS_RESEARCH_ENABLED=false
ODYSSEUS_SEARCH_ENABLED=false
ODYSSEUS_MCP_ENABLED=false
ODYSSEUS_COOKBOOK_ENABLED=false
ODYSSEUS_LOCAL_MODEL_DISCOVERY_ENABLED=false
ODYSSEUS_SHELL_ENABLED=false
ODYSSEUS_BROWSER_ENABLED=false
ODYSSEUS_VAULT_ENABLED=false
ODYSSEUS_GALLERY_ENABLED=false
ODYSSEUS_TTS_ENABLED=false
ODYSSEUS_STT_ENABLED=false
ODYSSEUS_COMPANION_ENABLED=false
ODYSSEUS_WEBHOOKS_ENABLED=false
ODYSSEUS_AGENT_MIGRATION_ENABLED=false
ODYSSEUS_CONTEXT_BUDGET_ENABLED=false
ODYSSEUS_AGENT_ALLOW_BASH=false
ODYSSEUS_AGENT_ALLOW_WEB_SEARCH=false
ODYSSEUS_AGENT_ALLOW_RESEARCH=false
HERMES_AGENT_ENABLED=false
HERMES_EXECUTABLE=hermes
# Optional Hermes data/profile scope. Point this at a dedicated runtime profile,
# never the operator's normal Hermes home or user profile.
HERMES_HOME=
HERMES_PROFILE=
# HAI keeps host-user Hermes configuration out of executions by default.
HERMES_IGNORE_USER_CONFIG=true
# This must be a dedicated folder that Hermes may inspect or modify. Do not
# point it at an entire user profile or unrestricted filesystem root.
HERMES_WORKSPACE=/root/agent-workspaces/hermes
HERMES_MAX_TURNS=20
HERMES_TIMEOUT_SECONDS=120
# Optional comma-separated Hermes toolsets and skills. Leave empty to let the
# configured Hermes profile decide. Prefer restrictive toolsets such as safe,
# web, file, skills, todo, or explicitly reviewed custom bundles.
HERMES_TOOLSETS=
HERMES_SKILLS=
# Ecosystem visibility flags. These do not bypass HAI approvals; they tell the
# runtime registry which Hermes surfaces are intentionally part of this HAI node.
HERMES_GATEWAY_ENABLED=false
HERMES_CRON_ENABLED=false
HERMES_MCP_ENABLED=false
HERMES_MOA_ENABLED=false
HERMES_SUBAGENTS_ENABLED=false
HERMES_MEMORY_SYNC_ENABLED=false
HERMES_ACP_ENABLED=false
HERMES_TERMINAL_BACKENDS=local,docker,ssh,singularity,modal,daytona
# Add only the credential/config variable names Hermes needs. Values are
# inherited at runtime but are never returned through the registry API.
HERMES_ENV_ALLOWLIST=
OPENCLAW_AGENT_ENABLED=false
OPENCLAW_EXECUTABLE=openclaw
# Optional local Gateway URL. For a Windows-host OpenClaw Gateway use:
# ws://host.docker.internal:18789
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_STATE_DIR=
OPENCLAW_CONFIG_PATH=
# Optional read-only ecosystem inventory source. This may point at an extracted
# OpenClaw repository/package or at openclaw-main.zip. HAI lists skills, skill
# scripts, root scripts, extensions, providers, channels, apps, packages, source
# modules, docs, QA/test assets, config profiles, security assets, deployment
# descriptors, prompt maps, GitHub workflows, repository docs/config, and
# control UI/controller modules from it, but does not run scripts, import code,
# or dispatch upstream automations from this path.
OPENCLAW_ECOSYSTEM_PATH=
# This must be a dedicated folder that OpenClaw may inspect or modify. Do not
# point it at an entire user profile or unrestricted filesystem root.
OPENCLAW_WORKSPACE=/root/agent-workspaces/openclaw
OPENCLAW_TIMEOUT_SECONDS=120
OPENCLAW_THINKING=high
OPENCLAW_ENV_ALLOWLIST=
# HAI only invokes `openclaw agent --message ...` through this adapter.
# Messaging, pairing, nodes, browser, cron, and public posting require separate
# reviewed HAI workflows before they should be enabled.
OPENCLAW_AGENT_CLI_ENABLED=true
OPENCLAW_GATEWAY_ENABLED=false
OPENCLAW_MESSAGES_ENABLED=false
OPENCLAW_SKILLS_ENABLED=false
OPENCLAW_PLUGINS_ENABLED=false
OPENCLAW_MCP_ENABLED=false
OPENCLAW_MEMORY_ENABLED=false
OPENCLAW_CRON_ENABLED=false
OPENCLAW_BROWSER_ENABLED=false
OPENCLAW_CANVAS_ENABLED=false
OPENCLAW_NODES_ENABLED=false
OPENCLAW_VOICE_ENABLED=false
OPENCLAW_TALK_ENABLED=false
OPENCLAW_WEBCHAT_ENABLED=false
OPENCLAW_PAIRING_ENABLED=false
OPENCLAW_EXEC_APPROVALS_ENABLED=false
OPENCLAW_HOST_TOOLS_ENABLED=false
OPENCLAW_PUBLIC_POSTING_ENABLED=false
OPENCLAW_WEB_SEARCH_ENABLED=false
OPENCLAW_MULTI_AGENT_ENABLED=false
OPENCLAW_APP_SDK_ENABLED=false
OPENCLAW_PLUGIN_SDK_ENABLED=false
OPENCLAW_LOCAL_MODELS_ENABLED=false
OPENCLAW_ALLOW_HIGH_RISK_EXECUTION=false
OPENCLAW_SANDBOX_REQUIRED=true
OPENCLAW_SANDBOX_MODE=all
OPENCLAW_SANDBOX_DOCKER_ENABLED=false
OPENCLAW_SANDBOX_SSH_ENABLED=false
OPENCLAW_SANDBOX_OPENSHELL_ENABLED=false
OPENCLAW_CHANNELS_ENABLED=
OPENCLAW_PROVIDERS_ENABLED=
OPENCLAW_COMPANION_APPS=windows,macos,ios,android
FREE_CLOUD_OPENAI_BASE_URL=
FREE_CLOUD_API_KEY=
LLM_GENERATION_TIMEOUT_SECONDS=60
LLM_ALLOW_LINK_LOCAL_ENDPOINTS=false
# DualPath is only meaningful for disaggregated LLM serving with separate
# prefill/decode engines, shared KV-cache storage, a compute transfer network,
# and a compatible global scheduler. Keep disabled for ordinary Ollama/LM Studio.
LLM_KV_CACHE_LOAD_STRATEGY=disabled
LLM_DUALPATH_INFRASTRUCTURE_VERIFIED=false

# Optional read-only MCP preflight. This is not an MCP execution adapter: it
# can only initialize explicitly configured local Streamable HTTP servers and
# list tools. No credentials, arbitrary URLs, process spawning, or tool calls
# are supported here. Format: id@reviewed-catalog-profile=http://host.docker.internal:3001/mcp;...
# The catalog profile must be an eligible MCP capability, for example
# mcp-inspector, fastmcp, github-mcp-server, playwright-mcp, or
# google-genai-toolbox (the stable HAI profile ID for MCP Toolbox).
HAI_MCP_PREFLIGHT_ENABLED=false
HAI_MCP_PREFLIGHT_SERVERS=
HAI_MCP_PREFLIGHT_TIMEOUT_SECONDS=5

# Optional local Temporal durability bridge. Enable only together with
# `docker compose --profile durability up --build`. The worker can create
# governed HAI follow-up proposals; it cannot send messages or bypass approval.
HAI_TEMPORAL_ENABLED=false
HAI_TEMPORAL_ADDRESS=temporal:7233
HAI_TEMPORAL_NAMESPACE=default
HAI_TEMPORAL_TASK_QUEUE=hai-governed-follow-up
# Use a long random local-only password before enabling the durability profile.
HAI_TEMPORAL_POSTGRES_PASSWORD=change-me-temporal-local-only

# Optional Playwright-backed local verification worker. This is a named,
# read-only verifier, not a browser agent: every profile must target a local
# origin and it cannot click, submit, download, retain cookies, or use public URLs.
# A completed check can be linked to an owner-authorized workflow only as a
# route-quality signal. It never verifies facts, updates memory, executes work,
# or completes a workflow.
HAI_PLAYWRIGHT_ENABLED=false
HAI_PLAYWRIGHT_RUNNER_URL=http://browser-verifier:8080
HAI_PLAYWRIGHT_RUNNER_TOKEN=change-me-browser-verifier-local-only
HAI_PLAYWRIGHT_PROFILES='[{"id":"hai-login","name":"HAI login route","url":"http://frontend/login","expectedPath":"/login"}]'
HAI_PLAYWRIGHT_ALLOWED_ORIGINS=http://frontend,http://localhost,http://127.0.0.1

# Optional local SearXNG source discovery. The repository supplies an
# internal-only `research-discovery` Compose profile. It has no host port;
# HAI reaches it as `searxng` over a dedicated internal network while SearXNG
# alone has outbound access to its configured search engines. Replace this
# placeholder before enabling the profile, for example with the output of
# `./scripts/generate-secrets.sh >> .env.local` or another local secret tool.
# HAI sends a bounded query only and presents unverified source candidates for
# review. It does not fetch result pages, use public SearXNG instances, or
# auto-store results. An admin may separately probe only /healthz.
HAI_SEARXNG_ENABLED=false
HAI_SEARXNG_BASE_URL=http://searxng:8080
HAI_SEARXNG_SECRET=change-this-local-searxng-secret

# Optional local RAGFlow evidence retrieval. HAI can query only the fixed
# dataset IDs below; it never uploads, deletes, invokes RAGFlow agents/code,
# or converts returned chunks directly into memory or facts. Set the base URL
# only after mapping RAGFlow's HTTP port to an explicit non-HAI host port.
HAI_RAGFLOW_ENABLED=false
HAI_RAGFLOW_BASE_URL=
HAI_RAGFLOW_API_KEY=
HAI_RAGFLOW_DATASET_IDS=

# Optional local MLflow evaluation evidence. HAI can only read recent runs from
# explicit experiment and metric allowlists. It never reads prompts, params,
# tags, datasets, artifacts, model registry, traces, or mutation APIs.
HAI_MLFLOW_ENABLED=false
HAI_MLFLOW_BASE_URL=
HAI_MLFLOW_BEARER_TOKEN=
HAI_MLFLOW_EXPERIMENT_IDS=
HAI_MLFLOW_METRIC_KEYS=
HAI_MLFLOW_TIMEOUT_SECONDS=8

# Optional local AnythingLLM candidate-evidence retrieval. HAI uses only the
# documented vector-search endpoint for the fixed workspace slugs below. It
# never opens workspace chat, sends attachments, reads history, or changes
# documents/settings. The upstream vector search uses the workspace embedding
# provider, so set the confirmation only after verifying it is local.
HAI_ANYTHINGLLM_ENABLED=false
HAI_ANYTHINGLLM_BASE_URL=http://host.docker.internal:3001
HAI_ANYTHINGLLM_API_KEY=
HAI_ANYTHINGLLM_WORKSPACE_SLUGS=
HAI_ANYTHINGLLM_LOCAL_EMBEDDINGS_CONFIRMED=false

# Optional read-only Serena semantic code-context bridge. Start Serena outside
# HAI in Streamable HTTP mode and pin it to exactly one reviewed project. HAI
# never launches it, changes project, forwards credentials, or calls any tool
# except find_symbol with source body and hover information disabled.
HAI_SERENA_ENABLED=false
HAI_SERENA_BASE_URL=http://host.docker.internal:9121/mcp
HAI_SERENA_PROJECT_ID=

# Optional Odoo JSON-2 source ingestion. Configure one operator-owned Odoo
# instance and a read-only API key. HAI only calls search_read on the fixed
# allowlist below and never writes back, calls generic RPC methods, or stores
# this API key in source records or audit logs.
HAI_ODOO_ENABLED=false
HAI_ODOO_BASE_URL=
HAI_ODOO_DATABASE=
HAI_ODOO_API_KEY=
HAI_ODOO_ALLOWED_MODELS=crm.lead,project.task
HAI_ODOO_SYNC_LIMIT=20

# Optional local Airbyte source/connection inventory. Set this only for an
# operator-hosted Airbyte API and explicit workspace UUID allowlist. HAI reads
# one bounded page of source and connection metadata only; it never reads
# connector configuration/credentials/records, starts syncs, or writes back.
HAI_AIRBYTE_ENABLED=false
HAI_AIRBYTE_BASE_URL=http://host.docker.internal:8000/api/v1
HAI_AIRBYTE_API_KEY=
HAI_AIRBYTE_WORKSPACE_IDS=

# Optional local CloudQuery sync-summary intake. Run CloudQuery separately and
# configure its `--summary-location` to emit one reviewed JSONL file inside the
# host directory below. HAI mounts that directory read-only, reads only newline-
# terminated summary records, and never runs CloudQuery, reads its config or
# credentials, or accesses the CloudQuery source/destination data.
HAI_CLOUDQUERY_SUMMARY_ENABLED=false
CLOUDQUERY_SUMMARY_HOST_DIR=./cloudquery-summary
HAI_CLOUDQUERY_ALLOWED_ROOT=/cloudquery-summary
HAI_CLOUDQUERY_SUMMARY_PATH=/cloudquery-summary/summary.jsonl
HAI_CLOUDQUERY_MAX_ENTRIES=50

# Optional local Presidio Analyzer second-pass PII detection. The bridge sends
# a bounded, user-submitted text value only to the local endpoint, returns
# entity metadata without the source text, and never treats no detections as
# proof that cloud, memory, or external-action use is safe. It does not
# anonymize, mask, delete, or persist content.
HAI_PRESIDIO_ENABLED=false
HAI_PRESIDIO_BASE_URL=http://host.docker.internal:3000
HAI_PRESIDIO_LANGUAGE=en
HAI_PRESIDIO_ENTITIES=EMAIL_ADDRESS,PHONE_NUMBER,PERSON,LOCATION,IBAN_CODE,CREDIT_CARD

# Optional local Evidently evaluation runner. It accepts only small synthetic
# or already-redacted fixtures, rejects detected PII and secrets before sending,
# and returns report metadata only. It cannot call providers, export data,
# change routing or policy, verify work, or trigger any execution.
HAI_EVIDENTLY_ENABLED=false
HAI_EVIDENTLY_BASE_URL=http://evidently-runner:8080
HAI_EVIDENTLY_TIMEOUT_SECONDS=8

# Optional local Guardrails AI fixed-schema validator. Enable only with
# `docker compose --profile validation up --build`. It validates one bounded,
# redacted action-proposal JSON contract and returns review metadata only; it
# cannot call a model, fetch Hub validators, authorize, persist, or execute.
HAI_GUARDRAILS_ENABLED=false
HAI_GUARDRAILS_BASE_URL=http://guardrails-runner:8080
HAI_GUARDRAILS_TIMEOUT_SECONDS=8

# Optional local PydanticAI typed-planning runner. Enable only with
# `docker compose --profile typed-planning up --build` after configuring an
# operator-reviewed loopback OpenAI-compatible endpoint and model. It returns
# one bounded schema-validated planning draft only: it has no tools, memory,
# source access, provider selection, retry loop, persistence, approval, or
# execution authority. HAI validates the draft separately before use.
HAI_PYDANTIC_AI_ENABLED=false
HAI_PYDANTIC_AI_BASE_URL=http://pydantic-ai-runner:8080
HAI_PYDANTIC_AI_TIMEOUT_SECONDS=20
HAI_PYDANTIC_AI_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
HAI_PYDANTIC_AI_LOCAL_MODEL_ID=
HAI_PYDANTIC_AI_LOCAL_API_KEY=

# Optional CrewAI local planning profile. Start it only with
# `docker compose --profile crewai-planning up --build`. The runner uses two
# fixed roles to prepare one review-only plan from a short task and success
# criteria. It has no HAI credentials, browser, files, sources, tools, memory,
# delegation, execution, or public provider surface. CrewAI telemetry is
# disabled in the Compose profile. Use an explicit local OpenAI-compatible
# model endpoint and leave this disabled until that endpoint has been reviewed.
HAI_CREWAI_ENABLED=false
HAI_CREWAI_BASE_URL=http://crewai-runner:8080
HAI_CREWAI_TIMEOUT_SECONDS=30
HAI_CREWAI_LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434/v1
HAI_CREWAI_LOCAL_MODEL_ID=
HAI_CREWAI_LOCAL_MODEL_API_KEY=

# Optional Microsoft Agent Framework sequential planning profile. Start only
# with `docker compose --profile agent-framework-planning up --build` after a
# reviewed local OpenAI-compatible endpoint and explicit model are configured.
# HAI submits only a short task plus up to eight criteria to two fixed no-tool
# roles. The output is a review-only JSON proposal; it cannot access HAI
# sources, memory, files, tools, MCP, credentials, workflow state, or execute.
HAI_AGENT_FRAMEWORK_ENABLED=false
HAI_AGENT_FRAMEWORK_BASE_URL=http://agent-framework-runner:8080
HAI_AGENT_FRAMEWORK_TIMEOUT_SECONDS=30
HAI_AGENT_FRAMEWORK_LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434/v1
HAI_AGENT_FRAMEWORK_LOCAL_MODEL_ID=
HAI_AGENT_FRAMEWORK_LOCAL_MODEL_API_KEY=

# Optional mini-SWE-agent disposable patch proposer. Enable only with
# `docker compose --profile mini-swe up --build` after initially preloading a
# reviewed model tag into the isolated `018-hai-miniswe-ollama-models` volume
# and placing exactly one sanitized, non-secret source snapshot inside one named
# child of `mini-swe-workspaces/`. Before a proposal, HAI's central daily
# maintenance gate refreshes only that exact tag through the isolated
# `ollama-miniswe` service; it cannot select another endpoint or model. The
# original source is mounted read-only; mini-SWE
# sees only a temporary copy and returns a bounded review-only diff. It cannot
# apply, commit, push, access the host, read Git metadata, use credentials, or
# reach the public network. A request requires an owner-scoped workflow that
# has already passed HAI's explicit approval gate and is in `ready` state. The
# workspace list accepts exactly one snapshot so the disposable agent cannot
# read a sibling source tree from the input mount.
# A completed proposal is linked back only by opaque diff digest as a
# `needs_review` workflow signal; the diff is never retained by HAI.
HAI_MINISWE_ENABLED=false
HAI_MINISWE_RUNNER_URL=http://miniswe-runner:8080
HAI_MINISWE_RUNNER_TOKEN=
HAI_MINISWE_WORKSPACES=
HAI_MINISWE_TIMEOUT_SECONDS=300
HAI_MINISWE_MODEL_ID=

# Optional FastMCP local read-only context bridge. Enable only with
# `docker compose --profile mcp-bridge up --build`. Generate two different
# local-only 32+ character tokens: the bridge token is used only between the
# FastMCP container and HAI; the client token is supplied only to the approved
# local MCP client at http://127.0.0.1:${HAI_FASTMCP_PORT}/mcp. The bridge gives
# that client only aggregate and bounded actionable workflow summaries,
# owner-scoped GitHub repository sync freshness (repository slug, project key,
# status, sync frequency, and last-sync time), and persisted model-maintenance
# readiness (no endpoint, digest, token, prompt, completion, token, quota, or
# cost data). It has no write, source-content, memory, policy, approval,
# runtime, model-route, model-refresh, or generation capability and HAI never
# receives the client token.
HAI_FASTMCP_BRIDGE_ENABLED=false
HAI_FASTMCP_BRIDGE_OWNER_ID=
HAI_FASTMCP_BRIDGE_TOKEN=
HAI_FASTMCP_CLIENT_TOKEN=
HAI_FASTMCP_PORT=8090
HAI_FASTMCP_BRIDGE_API_BASE_URL=http://backend:8080/api/v1/mcp-agent

# Optional local A2A planning bridge. It implements a small authenticated A2A
# 1.0-shaped profile for one peer: JSON-RPC `SendMessage` returns a
# non-executable planning draft. It is not a full A2A task-lifecycle server.
# Use a unique local-only 32+ character token and a named HAI owner. The URL
# must be loopback, host.docker.internal, gateway, or a private-network IP.
# It does not create tasks, refresh sources, persist plans, request approval,
# execute tools, reveal source/memory context, or discover other agents.
HAI_A2A_BRIDGE_ENABLED=false
HAI_A2A_BRIDGE_OWNER_ID=
HAI_A2A_BRIDGE_TOKEN=
HAI_A2A_BRIDGE_URL=http://127.0.0.1/api/v1/a2a

# Optional local LM Evaluation Harness runner. Enable only with
# `docker compose --profile model-evaluation up --build` after configuring one
# operator-reviewed local model endpoint. The fixed suite has six synthetic
# cases and returns aggregate metadata only; it cannot change routing, policy,
# budget, verification, memory, workflow, or execution behavior.
HAI_LM_EVAL_ENABLED=false
HAI_LM_EVAL_BASE_URL=http://lm-eval-runner:8080
HAI_LM_EVAL_TIMEOUT_SECONDS=130
HAI_LM_EVAL_MODEL_ID=
HAI_LM_EVAL_MODEL_BASE_URL=http://host.docker.internal:11434/v1

# Optional local Promptfoo safety-regression runner. Enable only with
# `docker compose --profile safety-evaluation up --build` after configuring one
# operator-reviewed local OpenAI-compatible endpoint. It runs one shipped,
# synthetic six-case suite and returns aggregate pass/fail metadata only. It
# cannot use real sources, accept caller prompts or providers, change routing,
# policy, verification, memory, workflow, approvals, or execution behavior.
HAI_PROMPTFOO_ENABLED=false
HAI_PROMPTFOO_BASE_URL=http://promptfoo-runner:8080
HAI_PROMPTFOO_TIMEOUT_SECONDS=130
HAI_PROMPTFOO_MODEL_ID=
HAI_PROMPTFOO_MODEL_BASE_URL=http://host.docker.internal:11434/v1

# Optional local DeepTeam agentic-safety regression runner. Enable only with
# `docker compose --profile deepteam-evaluation up --build` after configuring
# one operator-reviewed local OpenAI-compatible endpoint. It evaluates a fixed
# synthetic refusal target with two agentic/data-safety vulnerabilities and one
# bounded prompt-injection method, then returns aggregate metadata only. It
# never reads HAI data, targets real HAI behavior, accepts caller inputs, or
# changes routing, policy, verification, memory, workflow, approvals, or execution.
HAI_DEEPTEAM_ENABLED=false
HAI_DEEPTEAM_BASE_URL=http://deepteam-runner:8080
HAI_DEEPTEAM_TIMEOUT_SECONDS=180
HAI_DEEPTEAM_MODEL_ID=
HAI_DEEPTEAM_MODEL_BASE_URL=http://host.docker.internal:11434/v1
HAI_DEEPTEAM_MODEL_API_KEY=

# Optional local DeepEval source-grounding regression runner. Enable only with
# `docker compose --profile deepeval-evaluation up --build` after configuring
# one operator-reviewed local OpenAI-compatible judge. It evaluates three fixed
# synthetic evidence/answer pairs with the FaithfulnessMetric and returns only
# aggregate evaluator-accuracy metadata. It never receives a real HAI answer,
# source, credential, workflow, runtime, action, metric input, or caller data,
# and it cannot change routing, policy, verification, memory, approvals, or execution.
HAI_DEEPEVAL_ENABLED=false
HAI_DEEPEVAL_BASE_URL=http://deepeval-runner:8080
HAI_DEEPEVAL_TIMEOUT_SECONDS=180
HAI_DEEPEVAL_MODEL_ID=
HAI_DEEPEVAL_MODEL_BASE_URL=http://host.docker.internal:11434/v1
HAI_DEEPEVAL_MODEL_API_KEY=

# Optional local Garak prompt-injection safety runner. Enable only with
# `docker compose --profile garak-evaluation up --build` after configuring one
# operator-reviewed local OpenAI-compatible endpoint. It runs one shipped,
# four-case synthetic PromptInject probe and returns aggregate pass/fail
# metadata only. The runner never accepts a caller target, model, prompt,
# probe, report path, command, or data and deletes raw Garak reports.
HAI_GARAK_ENABLED=false
HAI_GARAK_BASE_URL=http://garak-runner:8080
HAI_GARAK_TIMEOUT_SECONDS=150
HAI_GARAK_MODEL_ID=
HAI_GARAK_MODEL_BASE_URL=http://host.docker.internal:11434/v1
HAI_GARAK_MODEL_API_KEY=

# Optional local Gitleaks safety scan. Enable only with
# `docker compose --profile secret-scan up --build` after copying one reviewed,
# access-approved source snapshot under ./security-snapshots/<snapshot-name> and
# listing only that name in HAI_GITLEAKS_WORKSPACES. HAI returns aggregate,
# redacted counts only; it never returns or retains secrets, matched text,
# source paths, lines, commits, authors, raw reports, or source content.
# Supplying an existing workflowId with a scan adds only a redacted, owner-scoped
# review signal; it cannot change workflow state, memory, execution, or completion.
HAI_GITLEAKS_ENABLED=false
HAI_GITLEAKS_RUNNER_URL=http://gitleaks-runner:8080
HAI_GITLEAKS_RUNNER_TOKEN=change-me-gitleaks-runner-local-only
HAI_GITLEAKS_WORKSPACES=
HAI_GITLEAKS_TIMEOUT_SECONDS=120

# Optional local Gosec static Go security analysis. Enable only with
# `docker compose --profile go-security-scan up --build` after copying one
# reviewed, access-approved Go source snapshot under ./security-snapshots/<name>.
# The snapshot must include `go.mod` and a complete `vendor/modules.txt`; the
# runner forces `-mod=vendor`, disables module downloads and proxy egress, and
# returns only aggregate severity/confidence counts. It never returns or retains
# source, paths, findings, rules, CWEs, raw reports, or remediation commands.
HAI_GOSEC_ENABLED=false
HAI_GOSEC_RUNNER_URL=http://gosec-runner:8080
HAI_GOSEC_RUNNER_TOKEN=change-me-gosec-runner-local-only
HAI_GOSEC_WORKSPACES=
HAI_GOSEC_TIMEOUT_SECONDS=120

# Optional local Trivy configuration-security review. Enable only with
# `docker compose --profile configuration-security-scan up --build` after
# copying one reviewed, access-approved configuration snapshot under
# ./security-snapshots/<name>. The runner uses Trivy offline config analysis
# only, disables update checks and proxy egress, and returns only aggregate
# severity counts and a digest. It never exposes source, paths, findings,
# policy, raw reports, image/repository/cloud scans, or remediation commands.
HAI_TRIVY_ENABLED=false
HAI_TRIVY_RUNNER_URL=http://trivy-runner:8080
HAI_TRIVY_RUNNER_TOKEN=change-me-trivy-runner-local-only
HAI_TRIVY_WORKSPACES=
HAI_TRIVY_TIMEOUT_SECONDS=120

# Optional local Grype vulnerability evidence. Enable only with
# `docker compose --profile vulnerability-scan up --build` after copying one
# reviewed, access-approved source snapshot under ./security-snapshots/<name>
# and a separately reviewed, locally maintained advisory database under
# ./security-advisories. The runner disables Grype database and app updates,
# has no egress, and returns only aggregate severity/fix-availability counts.
# It never returns or retains package, version, CVE, advisory, path, raw report,
# source content, or remediation command.
HAI_GRYPE_ENABLED=false
HAI_GRYPE_RUNNER_URL=http://grype-runner:8080
HAI_GRYPE_RUNNER_TOKEN=change-me-grype-runner-local-only
HAI_GRYPE_WORKSPACES=
HAI_GRYPE_TIMEOUT_SECONDS=120

# Optional local Syft SBOM inventory. Enable only with
# `docker compose --profile sbom-inventory up --build` after copying one
# reviewed, access-approved source snapshot under ./security-snapshots/<name>
# and listing only that name below. HAI returns aggregate package counts and
# ecosystem counts only; it never returns or retains an SBOM, package names,
# versions, licences, PURLs, source paths, or source content.
# Supplying an existing workflowId with an inventory adds only a redacted,
# owner-scoped review signal; it cannot change state, memory, execution, or completion.
HAI_SYFT_ENABLED=false
HAI_SYFT_RUNNER_URL=http://syft-runner:8080
HAI_SYFT_RUNNER_TOKEN=change-me-syft-runner-local-only
HAI_SYFT_WORKSPACES=
HAI_SYFT_TIMEOUT_SECONDS=120

# Optional local Langfuse observability bridge. Set this only for an
# operator-hosted, local/private Langfuse instance and a dedicated project key
# pair. HAI can probe the instance health/readiness and, only when an owner
# explicitly requests it, export one fixed aggregate control-plane OTLP span.
# It never exports prompts, source or workflow records, file content, model
# payloads, tokens, credentials, or caller-provided trace data.
HAI_LANGFUSE_ENABLED=false
HAI_LANGFUSE_BASE_URL=http://host.docker.internal:3000
HAI_LANGFUSE_PUBLIC_KEY=
HAI_LANGFUSE_SECRET_KEY=
HAI_LANGFUSE_TIMEOUT_SECONDS=8

# Optional local OpenLIT-compatible OTLP trace viewer. HAI does not install
# OpenLIT or use its SDK. An owner may export one fixed aggregate snapshot to a
# local collector; the bridge never sends prompts, completions, sources, files,
# model/token/workflow data, credentials, or caller-provided attributes.
HAI_OPENLIT_ENABLED=false
HAI_OPENLIT_OTLP_ENDPOINT=http://host.docker.internal:4318
HAI_OPENLIT_TIMEOUT_SECONDS=8

# Optional local whisper.cpp transcription. Enable only with
# `docker compose --profile local-transcription up --build` after manually
# placing a reviewed GGML model file in ./whisper-models. The runner receives
# only explicitly selected folders below ./connected-sources; it does not
# record a microphone, accept uploads, download models, contact cloud services,
# or retain raw audio. Trigger transcription from an owner-controlled
# `whisper-audio` source; transcripts enter normal source review as uncertain
# evidence and cannot send, publish, approve, or execute work.
HAI_WHISPER_CPP_ENABLED=false
HAI_WHISPER_CPP_BASE_URL=http://whispercpp-runner:8080
HAI_WHISPER_CPP_TIMEOUT_SECONDS=300
WHISPER_CPP_MODEL_FILE=
WHISPER_CPP_LANGUAGE=auto
WHISPER_CPP_FILE_LIMIT=25
WHISPER_CPP_MAX_AUDIO_BYTES=67108864
WHISPER_CPP_TIMEOUT_SECONDS=180

# Optional local Docling document extraction. Enable only with
# `docker compose --profile local-document-extraction up --build`, set a
# separate 16+ character runner token, and create a local-only
# `docling-documents` source that points at an explicit subfolder of
# ./connected-sources. The runner accepts no browser uploads, path/model/OCR/
# table/parser choices, cloud services, plugin loading, scheduled scans, or
# automatic model downloads. DOCX/PPTX/XLSX/HTML/Markdown/text extraction is
# available locally. PDF mode remains false unless reviewed Docling model
# artifacts are manually placed below ./docling-artifacts.
HAI_DOCLING_ENABLED=false
HAI_DOCLING_RUNNER_URL=http://docling-runner:8080
HAI_DOCLING_RUNNER_TOKEN=change-me-docling-runner-local-only
HAI_DOCLING_TIMEOUT_SECONDS=180
HAI_DOCLING_PDF_ENABLED=false

# Optional manifest-approved Wasmtime helpers. Do not enable before placing
# reviewed .wasm files in ./wasi-modules and recording their SHA-256 values.
HAI_WASI_ENABLED=false
HAI_WASI_RUNNER_URL=http://wasi-runner:8080
HAI_WASI_RUNNER_TOKEN=change-me-wasi-runner-local-only
HAI_WASI_MODULES=[]

# Nginx config manager.
NGINX_CONTAINER=gateway
CONFIG_DIR=/app/sites-enabled
NGINX_RELOAD_ENABLED=false

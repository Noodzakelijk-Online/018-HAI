events {
    worker_connections 1024;
}
http {
    resolver 127.0.0.11 valid=10s;
    resolver_timeout 5s;
    server {
        listen 80;

        # Resolve Docker service names per request so replacing a container
        # cannot leave the gateway pinned to its former IP address.
        set $backend_upstream backend:80;
        set $idp_upstream idp:8080;
        set $frontend_upstream frontend:80;
        set $generic_auto_upstream generic-auto:80;

        # Health endpoints are intentionally unauthenticated and must not fall
        # through to the Angular single-page application.
        location = /healthz {
            proxy_pass http://$backend_upstream;
        }

        location = /readyz {
            proxy_pass http://$backend_upstream;
        }

        location = /api/v1/agent-runtimes/openclaw/ecosystem/upload {
            client_max_body_size 800m;
            proxy_request_buffering off;
            auth_request /auth-verify;
            # Propagate a refreshed access token returned by the IDP auth subrequest.
            # Without this, the backend still receives the expired cookie that
            # triggered the refresh and rejects the otherwise authenticated request.
            auth_request_set $hai_refreshed_access_cookie $upstream_http_set_cookie;
            auth_request_set $hai_verified_access_token $upstream_http_x_hai_verified_access_token;
            add_header Set-Cookie $hai_refreshed_access_cookie always;
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Authorization "Bearer $hai_verified_access_token";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        # Authentication and account-management endpoints belong to the IDP.
        # Keep these explicit so every other product API can use the scalable
        # authenticated backend catch-all below without a route allowlist that
        # silently turns newly added modules into gateway 404s.
        location ^~ /api/v1/auth/ {
            proxy_pass http://$idp_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Auth-Subrequest "";
            proxy_hide_header X-HAI-Verified-Access-Token;
        }

        location ^~ /api/v1/user/ {
            proxy_pass http://$idp_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Auth-Subrequest "";
            proxy_hide_header X-HAI-Verified-Access-Token;
        }

        # OAuth callback: Google redirects the user's browser here after
        # consent, with no HAI session, so it cannot sit behind auth_request.
        # It is protected instead by the HMAC-signed state the backend issued,
        # and gated read-only by the backend (a public caller resolves to viewer).
        location = /api/v1/sources/oauth/google/callback {
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        # All non-IDP APIs are backend APIs. Authentication is checked by the
        # IDP subrequest and only its verified token is forwarded as identity.
        # The backend still enforces its own owner and RBAC checks.
        location /api/v1 {
            # A task run drives a model through a bounded MCP tool loop, which
            # takes minutes rather than seconds. The 60s proxy default cut the
            # browser off mid-run and reported a gateway timeout for work the
            # backend went on to finish.
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
            auth_request /auth-verify;
            auth_request_set $hai_refreshed_access_cookie $upstream_http_set_cookie;
            auth_request_set $hai_verified_access_token $upstream_http_x_hai_verified_access_token;
            add_header Set-Cookie $hai_refreshed_access_cookie always;
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Authorization "Bearer $hai_verified_access_token";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        location /auth-verify {
            internal;
            proxy_pass http://$idp_upstream/api/v1/auth/is-user-authenticated;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Auth-Subrequest "1";
        }

        error_page 401 /login;

        include /etc/nginx/sites-enabled/*.conf;

        location / {
            proxy_pass http://$frontend_upstream;
        }
    }
}

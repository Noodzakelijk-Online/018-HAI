events {
    worker_connections 1024;
}
http {
    resolver 127.0.0.11 valid=10s;
    server {
        listen 80;

        location = /api/v1/agent-runtimes/openclaw/ecosystem/upload {
            client_max_body_size 800m;
            proxy_request_buffering off;
            auth_request /auth-verify;
            proxy_pass http://backend:80;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
            # This request passed auth_verify, so the caller is the authenticated
            # local operator: grant the owner role for backend RBAC. Set (not
            # add) so a client cannot forge its own role header.
            proxy_set_header X-HAI-Role owner;
        }

        # Backend route groups. Anything not listed here falls through to the
        # IDP below and 404s, so this list must track the groups the backend
        # actually registers (agent-cycle, flags and system were previously
        # served by the backend but unreachable through the gateway).
        location ~ ^/api/v1/(agent-cycle|agent-runtimes|ambient|assistant|automation|autonomy|flags|llm|memory|memory-engine|pursuits|sources|system|task|verification|os|workflow)(/|$) {
            auth_request /auth-verify;
            proxy_pass http://backend:80;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
            # Authenticated session -> owner role for backend RBAC. Set (not add)
            # so a client-supplied X-HAI-Role cannot escalate privileges.
            proxy_set_header X-HAI-Role owner;
        }

        # Liveness: no authentication, and it reveals nothing beyond "the
        # process is up" — safe for an uptime check to poll.
        location = /healthz {
            proxy_pass http://backend:80;
        }

        # Readiness names hosts, brokers and which secrets are still
        # placeholders, so it stays behind the same auth as the API. Docker's
        # healthcheck reaches the backend directly on the compose network and
        # is unaffected by this.
        location = /readyz {
            auth_request /auth-verify;
            proxy_pass http://backend:80;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        location /api/v1 {
            proxy_pass http://idp:8080;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
        }

        location /auth-verify {
            proxy_pass http://idp:8080/api/v1/auth/is-user-authenticated;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
        }

        error_page 401 /login;

        include /etc/nginx/sites-enabled/*.conf;

        location / {
            proxy_pass http://frontend:80;
        }
    }
}

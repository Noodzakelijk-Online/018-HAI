events {
    worker_connections 1024;
}
http {
    resolver 127.0.0.11 valid=10s;
    resolver_timeout 5s;
    server {
        listen 80;

        # Resolve Docker service names per request so replacing a container
        # cannot leave the gateway pinned to its former IP address.
        set $backend_upstream backend:80;
        set $idp_upstream idp:8080;
        set $frontend_upstream frontend:80;
        set $generic_auto_upstream generic-auto:80;

        # Health endpoints are intentionally unauthenticated and must not fall
        # through to the Angular single-page application.
        location = /healthz {
            proxy_pass http://$backend_upstream;
        }

        location = /readyz {
            proxy_pass http://$backend_upstream;
        }

        location = /api/v1/agent-runtimes/openclaw/ecosystem/upload {
            client_max_body_size 800m;
            proxy_request_buffering off;
            auth_request /auth-verify;
            # Propagate a refreshed access token returned by the IDP auth subrequest.
            # Without this, the backend still receives the expired cookie that
            # triggered the refresh and rejects the otherwise authenticated request.
            auth_request_set $hai_refreshed_access_cookie $upstream_http_set_cookie;
            add_header Set-Cookie $hai_refreshed_access_cookie always;
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        location ~ ^/api/v1/(agent-runtimes|assistant|ambient|automation|autonomy|llm|memory|memory-engine|pursuits|task|sources|verification|os|workflow)(/|$) {
            auth_request /auth-verify;
            # See the upload location above: forward an IDP refresh cookie to the
            # browser so the backend verifies the same fresh token the IDP accepted.
            auth_request_set $hai_refreshed_access_cookie $upstream_http_set_cookie;
            add_header Set-Cookie $hai_refreshed_access_cookie always;
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        location /api/v1 {
            proxy_pass http://$idp_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
        }

        location /auth-verify {
            proxy_pass http://$idp_upstream/api/v1/auth/is-user-authenticated;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
        }

        error_page 401 /login;

        include /etc/nginx/sites-enabled/*.conf;

        location / {
            proxy_pass http://$frontend_upstream;
        }
    }
}
